{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuppet.local/schemas/provider-v2-benchmark-manifest.schema.json",
  "title": "Cuppet Provider V2 Benchmark Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tasks"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "project": {
      "type": "string",
      "minLength": 1,
      "description": "Disposable benchmark checkout. Prefer passing --project on the command line so machine-local paths are not committed."
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "model": { "type": "string" },
        "effort": { "type": "string" },
        "cliCommand": { "type": "string" },
        "cliArgs": { "type": "array", "items": { "type": "string" } },
        "baseUrl": { "type": "string" }
      },
      "description": "Non-secret provider selection only. Credentials remain in the local environment/provider installation."
    },
    "prepareCommand": {
      "type": "string",
      "minLength": 1,
      "description": "Command that restores identical project state before every raw-baseline and optimized task run."
    },
    "turnTimeoutMs": { "type": "integer", "minimum": 1000 },
    "verifyTimeoutMs": { "type": "integer", "minimum": 1000 },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minImprovements": { "type": "integer", "minimum": 1 }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prompt"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "prepareCommand": { "type": "string", "minLength": 1 },
          "verifyCommand": { "type": "string", "minLength": 1 },
          "expectOutput": { "type": "string", "minLength": 1 },
          "turnTimeoutMs": { "type": "integer", "minimum": 1000 },
          "verifyTimeoutMs": { "type": "integer", "minimum": 1000 }
        },
        "anyOf": [
          { "required": ["verifyCommand"] },
          { "required": ["expectOutput"] }
        ]
      }
    }
  }
}
