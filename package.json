{
  "name": "cuppet-desktop",
  "private": true,
  "version": "0.9.0-alpha.1",
  "description": "Independent Cuppet desktop/runtime migration",
  "author": "Officially-aditya",
  "type": "module",
  "main": "src/main/bootstrap.mjs",
  "bin": {
    "cuppet": "src/cli/main.mjs"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack:dir": "node scripts/verify-staged-tst.mjs && node scripts/verify-staged-codex.mjs && electron-builder --dir --publish never",
    "e1:audit-runtime": "npm audit --omit=dev --audit-level=high",
    "e1:package-smoke": "node scripts/smoke-packaged-runtime.mjs",
    "f1:stage-tst": "node scripts/stage-tst-runtime.mjs",
    "f1:verify-staged-tst": "node scripts/verify-staged-tst.mjs",
    "f1:package-smoke": "node scripts/smoke-packaged-tst.mjs",
    "f1:verify": "node scripts/verify-f1.mjs",
    "e2:stage-codex": "node scripts/stage-codex-app-server.mjs",
    "e2:verify-staged-codex": "node scripts/verify-staged-codex.mjs",
    "e2:package-smoke": "node scripts/smoke-packaged-codex.mjs",
    "e2:verify": "node scripts/verify-e2.mjs",
    "remote-control": "node src/cli/main.mjs remote-control",
    "relay": "node src/cli/main.mjs relay",
    "remote-enroll": "node src/cli/main.mjs remote-enroll",
    "models": "node src/cli/main.mjs models",
    "phase0:verify": "node scripts/verify-phase0.mjs",
    "phase1:verify": "node scripts/verify-phase1.mjs",
    "phaseb:verify": "node scripts/verify-phaseb.mjs",
    "phaseb1:verify": "node scripts/verify-phaseb1.mjs",
    "phaseb2:verify": "node scripts/verify-phaseb2.mjs",
    "phasec1:verify": "node scripts/verify-phasec1.mjs",
    "phasec2:verify": "node scripts/verify-phasec2.mjs",
    "phased:verify": "node scripts/verify-phased.mjs",
    "phasee:verify": "node scripts/verify-phasee.mjs",
    "original-c1:verify": "node scripts/verify-original-c1.mjs",
    "original-c2:verify": "node scripts/verify-original-c2.mjs",
    "d1:verify": "node scripts/verify-d1.mjs",
    "d3:verify": "node scripts/verify-d3.mjs",
    "e1:verify": "node scripts/verify-e1.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "com.cuppet.desktop",
    "productName": "Cuppet",
    "executableName": "cuppet",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/tst",
        "to": "tst",
        "filter": ["**/*"]
      },
      {
        "from": "vendor/codex",
        "to": "codex",
        "filter": ["**/*"]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dir"]
    },
    "linux": {
      "category": "Development",
      "target": ["dir"]
    },
    "win": {
      "target": ["dir"]
    }
  }
}
