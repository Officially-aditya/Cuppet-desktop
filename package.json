{
  "name": "cuppet-desktop",
  "private": true,
  "version": "0.9.0-alpha.33",
  "description": "Independent Cuppet desktop/runtime migration",
  "author": "Officially-aditya",
  "type": "module",
  "main": "src/main/bootstrap.mjs",
  "bin": {
    "cuppet": "src/cli/main.mjs"
  },
  "scripts": {
    "prebuild:renderer": "npm run ipc:generate && npm run mac:prepare-icon",
    "ipc:generate": "node scripts/generate-ipc.mjs",
    "ipc:check": "node scripts/generate-ipc.mjs --check",
    "runtime:typecheck": "tsc --noEmit -p tsconfig.runtime.json",
    "build:renderer": "vite build",
    "renderer:verify": "npm run ipc:check && tsc --noEmit && npm run runtime:typecheck && vite build && node scripts/verify-renderer.mjs",
    "renderer:reasoning-smoke": "electron scripts/smoke-reasoning-renderer.mjs",
    "renderer:streaming-smoke": "electron scripts/smoke-streaming-interactions.mjs",
    "start": "npm run build:renderer && electron .",
    "dev:renderer": "vite",
    "test": "node --test test/*.test.mjs",
    "benchmark:chat-switch": "node benchmarks/chat-switch.mjs",
    "benchmark:chat-switch:renderer": "npm run build:renderer && electron benchmarks/chat-switch.mjs",
    "mac:prepare-icon": "node scripts/prepare-macos-icon.mjs",
    "pack:dir": "npm run mac:prepare-icon && node scripts/verify-staged-tst.mjs && node scripts/verify-staged-codex.mjs && npm run browsercontrol:verify && npm run renderer:verify && electron-builder --dir --publish never",
    "release:verify": "node scripts/verify-release-security.mjs",
    "release:mac": "npm run mac:prepare-icon && npm run f1:verify-staged-tst && npm run e2:verify-staged-codex && npm run browsercontrol:verify && npm run renderer:verify && npm run release:verify && electron-builder --config build/electron-builder.release.json --mac --arm64 --publish never",
    "release:win": "npm run mac:prepare-icon && node scripts/verify-staged-tst.mjs && node scripts/verify-staged-codex.mjs && npm run browsercontrol:verify && npm run renderer:verify && electron-builder --config build/electron-builder.win.json --win --x64 --publish never",
    "release:feed": "node scripts/build-macos-update-feed.mjs",
    "e1:audit-runtime": "npm audit --audit-level=high",
    "e1:package-smoke": "node scripts/smoke-packaged-runtime.mjs",
    "f1:stage-tst": "node scripts/stage-tst-runtime.mjs",
    "f1:verify-staged-tst": "node scripts/verify-staged-tst.mjs",
    "f1:package-smoke": "node scripts/smoke-packaged-tst.mjs",
    "f1:verify": "node scripts/verify-f1.mjs",
    "e2:stage-codex": "node scripts/stage-codex-app-server.mjs",
    "e2:verify-staged-codex": "node scripts/verify-staged-codex.mjs",
    "e2:package-smoke": "node scripts/smoke-packaged-codex.mjs",
    "e2:verify": "node scripts/verify-e2.mjs",
    "remote-control": "node src/cli/main.mjs remote-control",
    "relay": "node src/cli/main.mjs relay",
    "remote-enroll": "node src/cli/main.mjs remote-enroll",
    "models": "node src/cli/main.mjs models",
    "phase0:verify": "node scripts/verify-phase0.mjs",
    "phase1:verify": "node scripts/verify-phase1.mjs",
    "phaseb:verify": "node scripts/verify-phaseb.mjs",
    "phaseb1:verify": "node scripts/verify-phaseb1.mjs",
    "phaseb2:verify": "node scripts/verify-phaseb2.mjs",
    "phasec1:verify": "node scripts/verify-phasec1.mjs",
    "phasec2:verify": "node scripts/verify-phasec2.mjs",
    "phased:verify": "node scripts/verify-phased.mjs",
    "phasee:verify": "node scripts/verify-phasee.mjs",
    "original-c1:verify": "node scripts/verify-original-c1.mjs",
    "original-c2:verify": "node scripts/verify-original-c2.mjs",
    "d1:verify": "node scripts/verify-d1.mjs",
    "d3:verify": "node scripts/verify-d3.mjs",
    "e1:verify": "node scripts/verify-e1.mjs",
    "browsercontrol:stage": "node scripts/stage-browsercontrol-runtime.mjs",
    "browsercontrol:verify": "node scripts/verify-staged-browsercontrol.mjs",
    "browsercontrol:package-smoke": "node scripts/smoke-packaged-browsercontrol.mjs"
  },
  "dependencies": {
    "json5": "2.2.3",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "highlight.js": "11.11.1",
    "qrcode": "1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.2",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "com.cuppet.desktop",
    "productName": "Cuppet",
    "executableName": "cuppet",
    "asar": true,
    "electronFuses": {
      "runAsNode": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    },
    "asarUnpack": [
      "src/runtime/providers/transports/acp/cuppet-mcp-stdio.mjs",
      "src/runtime/providers/opencode-steering/**/*",
      "node_modules/node-pty/**/*"
    ],
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "src/shared/**/*",
      "src/runtime/**/*",
      "src/cli/**/*",
      "dist-renderer/**/*",
      "src/remote-app/**/*",
      "build/icon.png",
      "build/icon-macos.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/tst",
        "to": "tst",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/codex",
        "to": "codex",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/browsercontrol",
        "to": "browsercontrol",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "icon": "build/icon-macos.png",
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "Cuppet and your local coding provider need access to projects and their configuration in your Documents folder.",
        "NSDownloadsFolderUsageDescription": "Cuppet and your local coding provider need access to projects and their configuration in your Downloads folder.",
        "NSDesktopFolderUsageDescription": "Cuppet and your local coding provider need access to projects and their configuration on your Desktop."
      },
      "target": [
        "dir"
      ]
    },
    "linux": {
      "category": "Development",
      "target": [
        "dir"
      ]
    },
    "win": {
      "target": [
        "dir"
      ]
    }
  }
}
