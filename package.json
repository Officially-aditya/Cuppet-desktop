{
  "name": "cuppet-desktop",
  "private": true,
  "version": "0.6.0-alpha.1",
  "description": "Independent Cuppet desktop/runtime migration",
  "type": "module",
  "main": "src/main/main.mjs",
  "bin": {
    "cuppet": "src/cli/main.mjs"
  },
  "scripts": {
