{
  "appId": "com.cuppet.desktop",
  "productName": "Cuppet",
  "executableName": "cuppet",
  "artifactName": "${productName}-${version}-${arch}.${ext}",
  "asar": true,
  "electronFuses": {
    "runAsNode": true,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "onlyLoadAppFromAsar": true,
    "resetAdHocDarwinSignature": true
  },
  "asarUnpack": [
    "src/runtime/providers/transports/acp/cuppet-mcp-stdio.mjs",
    "node_modules/node-pty/**/*"
  ],
  "files": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/runtime/**/*",
    "src/cli/**/*",
    "dist-renderer/**/*",
    "src/remote-app/**/*",
    "build/icon.png",
    "build/icon-macos.png",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "vendor/tst",
      "to": "tst",
      "filter": ["**/*"]
    },
    {
      "from": "vendor/codex",
      "to": "codex",
      "filter": ["**/*"]
    },
    {
      "from": "vendor/browsercontrol",
      "to": "browsercontrol",
      "filter": ["**/*"]
    }
  ],
  "directories": {
    "output": "dist"
  },
  "forceCodeSigning": false,
  "mac": {
    "icon": "build/icon-macos.png",
    "category": "public.app-category.developer-tools",
    "extendInfo": {
      "NSDocumentsFolderUsageDescription": "Cuppet and your local coding provider need access to projects and their configuration in your Documents folder."
    },
    "identity": null,
    "hardenedRuntime": false,
    "notarize": false,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.inherit.plist",
    "target": ["dmg", "zip"]
  },
  "publish": [
    {
      "provider": "github",
      "owner": "Officially-aditya",
      "repo": "Cuppet-desktop",
      "releaseType": "release",
      "tagNamePrefix": "v",
      "publishAutoUpdate": false
    }
  ]
}
