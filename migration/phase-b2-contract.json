    "workspaceTruth": "current filesystem",
    "graphLocalization": "TST when configured",
    "semanticVectors": "in-memory cache only",
    "renderer": "projection only"
  },
  "routingOrder": [
    "deterministic task affinity",
    "TST graph localization for ambiguous prompts",
    "local feature embedding fallback",
    "conservative continue/create/reactivate decision"
  ],
  "semantic": {
    "provider": "built-in deterministic subword feature hashing",
    "defaultModel": "cuppet/subword-hash-v1",
    "dimensions": 512,
    "networkDependency": false,
    "nativeDependency": false,
    "modelDownload": false,
    "remoteRoutingInference": false,
    "failureFallback": "continue active task",
    "vectorsPersisted": false,
    "falseSplitPolicy": "prefer missed split over low-confidence false split"
  },
  "persistence": {
    "maxAgents": 32,
    "storesTranscript": false,
    "storesProviderPrompt": false,
    "storesCredentials": false,
    "storesEmbeddingVectors": false,
    "corruptRegistry": "fail closed to fresh routing state",
    "offlineFileChange": "remove privileged path evidence, mark stale, require refresh"
  },
  "handoff": {
    "states": ["prepared", "accepted", "committed", "aborted"],
    "order": ["prepare", "accept", "SQLite transaction", "router commit"],
    "sourcePromptWrittenBeforeCommit": false,
    "createTargetSessionInsideTransaction": true,
    "crossSessionSourceRecord": "bounded PE3 routing marker only",
    "failureBehavior": "abort handoff and preserve source request"
  },
  "attachments": {
    "maxCount": 16,
    "metadataOnly": true,
    "mimeValidated": true,
    "contentInvented": false
  },
  "runtimeControls": {
    "disableEnv": "CUPPET_PE3=0",
    "embeddingProviderOverride": "constructor injection only; production default has no external model/runtime dependency"
